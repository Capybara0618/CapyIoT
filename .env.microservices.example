# Non-secret example only. init_microservices.py creates the real file below ignored var/.
# Never combine compose.microservices.yml with the historical compose.yml.
MS_PROJECT=capyiot-ms-verify-example
MS_BUNDLE=./var/bundles/capyiot-ms-verify-example
MS_VOLUME_PREFIX=capyiot-ms-verify-example
MS_WRITERS_ENABLED=false
MS_PLATFORM_BOOTSTRAP=true
MS_MODEL_MODE=offline
MS_IMAGE_TAG=candidate
MS_HTTP_PORT=28088
MS_HTTPS_PORT=28443
MS_MQTT_PORT=28883
MS_PROMETHEUS_PORT=29095
MS_GRAFANA_PORT=23000
MS_JAEGER_PORT=26686
MS_PROMETHEUS_URL=
DEEPSEEK_MODEL=offline-fixture
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_RUN_OUTPUT_TOKEN_BUDGET=8192
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
