{
  "uid": "capyiot",
  "title": "CapyIoT 服务监控",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka 消费积压",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(capyiot_kafka_group_lag)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "设备事件处理速率",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(capyiot_device_events_projected_total[2m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API P95",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(service,le)(rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*|/api/v1/stream|/api/v1/.*/stream\"}[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM 堆使用量",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(jvm_memory_used_bytes{area=\"heap\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM GC 暂停",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(jvm_gc_pause_seconds_sum[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HikariCP 活跃连接",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(hikaricp_connections_active)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MySQL 查询路径 P95",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(query,le)(rate(capyiot_query_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis 设备汇总查询命中率",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(capyiot_query_cache_total{result=\"hit\"}[5m]))/sum(rate(capyiot_query_cache_total[5m]))"
        }
      ]
    }
  ]
}